# --- Data mode ---
# true  = read from an in-browser mock (no contract needed).
# false = read from the deployed escrow contract below.
NEXT_PUBLIC_USE_MOCKS=true

# --- Live contract (required when NEXT_PUBLIC_USE_MOCKS=false) ---
# Deployed BountyEscrow address. With a zero/empty value the UI shows a
# "contract not configured" notice instead of querying 0x0.
NEXT_PUBLIC_ESCROW_ADDRESS=0x0000000000000000000000000000000000000000

# --- Chain ---
# 11155111 = Sepolia (default), 31337 = local Hardhat node.
NEXT_PUBLIC_CHAIN_ID=11155111
# Optional custom RPC endpoint; omit to use the chain's public RPC.
NEXT_PUBLIC_RPC_URL=
# Block the escrow was deployed at; bounds event scans. 0 = scan from genesis.
NEXT_PUBLIC_DEPLOY_BLOCK=0

# --- WalletConnect / Reown project id (optional) ---
NEXT_PUBLIC_WC_PROJECT_ID=
