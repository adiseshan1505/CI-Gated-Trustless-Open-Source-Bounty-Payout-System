# When true, the UI reads from an in-memory mock instead of a live chain.
NEXT_PUBLIC_USE_MOCKS=true

# Deployed escrow contract address (required when NEXT_PUBLIC_USE_MOCKS=false).
NEXT_PUBLIC_ESCROW_ADDRESS=0x0000000000000000000000000000000000000000

# WalletConnect / Reown project id (optional; enables WalletConnect connectors).
NEXT_PUBLIC_WC_PROJECT_ID=
