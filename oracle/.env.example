# Copy to .env and fill in. Never commit .env.

# Raises the GitHub API rate limit for simulate.js and relayer.js (read-only, public_repo scope is enough).
GITHUB_TOKEN=

# --- relayer.js only ---
RPC_URL=http://127.0.0.1:8545
# Must equal BountyEscrow.relayer(). Use a dedicated testnet-only key.
RELAYER_PRIVATE_KEY=
ESCROW_ADDRESS=
# Block to start scanning SubmissionCreated events from (the deployment block).
FROM_BLOCK=0
POLL_INTERVAL_MS=15000
LOG_BLOCK_RANGE=5000
