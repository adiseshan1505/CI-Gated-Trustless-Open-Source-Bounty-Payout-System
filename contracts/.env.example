# Copy to .env and fill in. Never commit .env.

# --- Sepolia deployment ---
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/<your-key>
DEPLOYER_PRIVATE_KEY=0x<private-key-of-a-testnet-only-wallet>
ETHERSCAN_API_KEY=

# --- Chainlink Functions (Sepolia) ---
# Check current values at https://docs.chain.link/chainlink-functions/supported-networks
FUNCTIONS_ROUTER=0xb83E47C2bC239B3bf370bc41e1459A34b41238D0
FUNCTIONS_DON_ID=fun-ethereum-sepolia-1
# Create and fund a subscription at https://functions.chain.link, then add the
# deployed contract as a consumer. Leave 0 to deploy without Functions.
FUNCTIONS_SUBSCRIPTION_ID=0
FUNCTIONS_CALLBACK_GAS_LIMIT=300000
# DON-hosted secrets holding `githubToken` (optional; 0 = no secrets).
FUNCTIONS_SECRETS_SLOT_ID=0
FUNCTIONS_SECRETS_VERSION=0

# --- Relayer (optional alternative to Chainlink Functions) ---
# Address allowed to call verifySubmission(). Leave empty to disable.
RELAYER_ADDRESS=
